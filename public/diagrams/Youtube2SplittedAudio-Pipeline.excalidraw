      "index": "b30",
      "roundness": null,
      "seed": 1703663570,
      "version": 542,
      "versionNonce": 1939369810,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1733812216134,
      "link": null,
      "locked": false,
      "text": "A loop to adjust timestamps to\nensure each speech segment:  \n1. Has a long enough duration.  \n2. Is not too large.  \n3. Is properly cut in the middle\nof a no-speech segment.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "_1aLqbwNrg5JlxRGfxESs",
      "originalText": "A loop to adjust timestamps to ensure each speech segment:  \n1. Has a long enough duration.  \n2. Is not too large.  \n3. Is properly cut in the middle of a no-speech segment.",
      "autoResize": true,
      "lineHeight": 1.25
    },

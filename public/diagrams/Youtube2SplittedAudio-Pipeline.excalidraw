    {
      "id": "eEA8E1BmwvJfE51jcyRXX",
      "type": "text",
      "x": 719.5193161129937,
      "y": 4415.406694337779,
      "width": 311.1798400878906,
      "height": 150,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,

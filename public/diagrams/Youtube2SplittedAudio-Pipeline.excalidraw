      "updated": 1733810540529,
      "link": null,
      "locked": false,
      "text": "Intuition behind this part: \nWe want to divide the audio file into smaller segments \ndue to memory limitations. \nHowever, we aim to ensure that the cuts occur only at \npositions with no speech and where the pauses are sufficiently long\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Intuition behind this part: \nWe want to divide the audio file into smaller segments \ndue to memory limitations. \nHowever, we aim to ensure that the cuts occur only at \npositions with no speech and where the pauses are sufficiently long\n",
      "autoResize": true,
      "lineHeight": 1.25
    },

      "seed": 1104634578,
      "version": 613,
      "versionNonce": 1610201358,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1733811599766,
      "link": null,
      "locked": false,
      "text": "The initial silence time threshold is set to 0.5 seconds \nIf no silence of 0.5 seconds or longer is found and \nthe segment duration still exceeds the maximum \nallowed duration, the while loop reduces the silence time threshold \nby 0.1 seconds and restarts the process",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The initial silence time threshold is set to 0.5 seconds \nIf no silence of 0.5 seconds or longer is found and \nthe segment duration still exceeds the maximum \nallowed duration, the while loop reduces the silence time threshold \nby 0.1 seconds and restarts the process",
      "autoResize": true,
      "lineHeight": 1.25
    },
